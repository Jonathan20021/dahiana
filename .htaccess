# ---------------------------------------------------------------------------
# Proteccion de archivos que no deben servirse por la web.
#
# El motivo: /.git/ estaba accesible y con eso se podia descargar el repositorio
# completo, incluido config.php con las credenciales de la base de produccion.
# Tambien quedaban expuestos database.sql, composer.* y, en cuanto se usa la
# boveda, vault.key (la clave maestra que descifra las contrasenas de todos los
# clientes).
#
# Requiere AllowOverride All en el vhost. Si el hosting no lo permite, hay que
# aplicar el equivalente en la configuracion del servidor o, mejor, mover el
# docroot a un subdirectorio public/.
# ---------------------------------------------------------------------------

# Sin listados de directorio
Options -Indexes

# --- Directorios y archivos ocultos (.git, .env, .vscode, .idea, .DS_Store) ---
RedirectMatch 404 (?i)/\.(git|svn|hg|env|vscode|idea|ds_store|htpasswd)

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Cualquier ruta con un componente que empiece por punto
    RewriteRule (^|/)\. - [F,L]

    # --- Facturas: solo por serve_invoice.php ---
    # aiHardenUploadsDir() escribe un .htaccess dentro de uploads/invoices/,
    # pero solo corre cuando algo llama a aiUploadsDir(), y todos esos sitios
    # estan detras del login: recien desplegado, y hasta que alguien suba o
    # abra una factura, el directorio se queda sin proteger. Si ademas no hay
    # permiso de escritura, no se protege nunca. Esta regla no depende de nada
    # en runtime: viaja en el repositorio y bloquea desde el primer request.
    # readfile() desde PHP no pasa por aqui, asi que serve_invoice.php sigue
    # sirviendo el archivo con normalidad.
    RewriteRule ^uploads/invoices/ - [F,L]
</IfModule>

# --- Archivos sensibles por nombre o extension ---
<FilesMatch "(?i)^(vault\.key|composer\.(json|lock|phar)|package(-lock)?\.json|database\.sql|.*\.(sql|log|key|pem|bak|tmp|swp|dist|ini|md|sh|yml|yaml)|config\.local\.php|\.env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Cabeceras de seguridad basicas ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # La cookie de sesion nunca deberia salir en una respuesta cacheada.
    #
    # serve_invoice.php queda fuera a proposito: es un .php, pero devuelve la
    # imagen de una factura, no HTML con la sesion dentro. Con el no-store el
    # navegador volvia a bajar todas las miniaturas en cada recarga del listado
    # -- varios MB por vista, y el portal se usa sobre todo desde el telefono.
    # Se excluye en vez de sobreescribirlo despues porque "Header always" mete
    # su valor en err_headers_out, que se suma a lo que puso PHP en lugar de
    # reemplazarlo: quedaban dos Cache-Control peleando. Asi manda el script,
    # que ya distingue entre servir el archivo (cache privada de 10 minutos) y
    # responder 401/404 (sin cache).
    Header always set Cache-Control "no-store" "expr=%{REQUEST_URI} =~ m#\.php$# && %{REQUEST_URI} !~ m#/serve_invoice\.php$#"
</IfModule>
